# Roleplay AI Backend - Environment Variables
# Copy this file to each service folder as .env and fill values

# --- PostgreSQL ---
DATABASE_URL=postgresql://username:password@host:5432/db

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=your-qdrant-api-key

# --- BGE-M3 Embeddings/ any provider change the EMBED_DIM in shared/db/qdrant.py ---
DIGITALOCEAN_BGE_KEY=
DIGITALOCEAN_BGE_URL=

# --- LLM ---
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Default max tokens for AI responses
LLM_MAX_TOKENS=512
# Temperature for roleplay creativity (0.0 - 1.0)
LLM_TEMPERATURE=0.75

# --- NATS / JetStream ---
NATS_URL=
# If NATS requires authentication:
NATS_USER=
NATS_PASSWORD=

# --- FastAPI Server ---
# API Server port
API_PORT=8000
# CORS origins (comma-separated)

# --- Logging ---
LOG_LEVEL=INFO

# Durable broker replay limits (SQL chat history is retained independently)
NATS_RETENTION_SECONDS=604800
NATS_STREAM_MAX_BYTES=536870912

# Shared provider admission and embedding cache (Valkey protocol, not HTTP)
VALKEY_URL=redis://127.0.0.1:6379/0
PROVIDER_RPM=120
PROVIDER_TPM=1000000
PROVIDER_CONCURRENCY=8
JOB_TIMEOUT_SECONDS=180
MEMORY_MAX_TOKENS=4096
# Optional per-role overrides: VALIDATION_MODEL, VALIDATION_API_URL,
# VALIDATION_API_KEY, DIRECTOR_MODEL, DIRECTOR_API_URL, DIRECTOR_API_KEY,
# MEMORY_MODEL, MEMORY_API_URL, MEMORY_API_KEY.
# Optional: PROVIDER_BUDGET_GROUP shares limits across multiple provider endpoints.
# Optional: OTEL_EXPORTER_OTLP_ENDPOINT (install pip install -e '.[telemetry]').
